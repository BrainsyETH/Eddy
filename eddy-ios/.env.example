# Mapbox public access token. Required for the Map tab.
#
# EXPO_PUBLIC_ is intentional: a `pk.` token is public by design and ships inside
# every app binary. Restrict it by URL/scope in the Mapbox dashboard rather than
# trying to hide it. You do NOT need a secret `sk.` download token — the
# @rnmapbox/maps config plugin marks RNMapboxMapsDownloadToken deprecated.
#
# Copy this file to .env (gitignored) and fill it in. For EAS builds, set the
# same variable per environment with `eas env:create`.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Supabase — used for AUTH ONLY (an anonymous identity so Favorites can sync).
# Data still goes through the Next.js API. The app works fully without these:
# Favorites simply stays on-device.
#
# Values come from the Supabase dashboard under Project Settings > API Keys.
# NOTE: anonymous sign-ins must also be enabled under Authentication >
# Providers, or the client gets 422 anonymous_provider_disabled and stays local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public iOS SDK key (Project Settings > API Keys > Apple App Store).
# Optional: without it the app runs with purchases disabled — Profile says so
# rather than showing a control that cannot work. The SERVER remains the
# authority on entitlement either way; this key only drives the purchase and
# restore flow. Like the Mapbox token it is public by design and ships in the
# binary; the secret RevenueCat key belongs on the backend, never here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Which backend the app talks to. Leave unset for production (https://eddy.guide).
#
# REQUIRED FOR SANDBOX TESTING. A StoreKit sandbox purchase writes an
# entitlement tagged environment='SANDBOX', and those are ignored at read time
# unless ALLOW_SANDBOX_ENTITLEMENTS is set on the backend — which belongs on
# preview deploys only. Point a sandbox build at a preview deploy or the
# purchase will succeed at Apple and still show as no subscription.
#
# See docs/SANDBOX_TESTING.md in missouri-float-planner.
EXPO_PUBLIC_API_BASE_URL=
