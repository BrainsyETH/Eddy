{
  "expo": {
    "name": "Eddy",
    "slug": "eddy",
    "version": "1.5.0",
    "orientation": "default",
    "scheme": "eddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon-polished-light.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eddy.guide.app",
      "associatedDomains": [
        "applinks:eddy.guide"
      ],
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "icon": {
        "light": "./assets/icon-polished-light.png",
        "dark": "./assets/icon-polished-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "onxoffroad",
          "gaiagps",
          "comgooglemaps",
          "waze"
        ],
        "NSLocationTemporaryUsageDescriptionDictionary": {
          "FloatTracking": "Eddy needs your precise location to place you on the river and measure your progress to the take-out."
        }
      },
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      "./plugins/withSerialMapboxOffline",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-polished.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3",
          "dark": {
            "image": "./assets/splash-icon-polished.png",
            "backgroundColor": "#1A1814"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eddy uses your location to find nearby rivers and put-ins, show local weather, and track your float, even while your phone is locked, until you end it. Approximate location is sent to Eddy for weather and nearby searches; raw float positions stay on your phone.",
          "locationAlwaysAndWhenInUsePermission": "During a float, Eddy keeps tracking your progress to the take-out while your phone is locked, and stops when you end the float. Raw float positions stay on your phone. Signed-in trip summaries are backed up.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eddy uses your photos so you can show other floaters what the river looked like.",
          "cameraPermission": "Eddy uses your camera so you can show other floaters what the river looks like right now.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "./plugins/withFloatActivity",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://eddy.guide",
      "router": {},
      "eas": {
        "projectId": "018d7a3e-7e3c-47a9-bd02-1fe370317a7f"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/018d7a3e-7e3c-47a9-bd02-1fe370317a7f"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}
