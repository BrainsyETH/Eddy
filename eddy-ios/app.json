{
  "expo": {
    "name": "Eddy",
    "slug": "eddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "eddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "guide.eddy.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://eddy.guide",
      "router": {},
      "eas": {
        "projectId": "018d7a3e-7e3c-47a9-bd02-1fe370317a7f"
      }
    }
  }
}
