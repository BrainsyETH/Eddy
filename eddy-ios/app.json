{
  "expo": {
    "name": "Eddy",
    "slug": "eddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "eddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eddy.guide.app",
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1A1814"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://eddy.guide",
      "router": {},
      "eas": {
        "projectId": "018d7a3e-7e3c-47a9-bd02-1fe370317a7f"
      }
    }
  }
}
