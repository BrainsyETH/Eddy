{
  "expo": {
    "name": "Eddy",
    "slug": "eddy",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "eddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon-polished-light.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eddy.guide.app",
      "associatedDomains": [
        "applinks:eddy.guide"
      ],
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/icon-polished-light.png",
        "dark": "./assets/icon-polished-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "onxoffroad",
          "gaiagps",
          "comgooglemaps"
        ]
      },
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-polished.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3",
          "dark": {
            "image": "./assets/splash-icon-polished.png",
            "backgroundColor": "#1A1814"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eddy uses your location to show which put-ins and rivers are closest to you. It is never sent to our servers.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eddy uses your photos so you can show other floaters what the river looked like.",
          "cameraPermission": "Eddy uses your camera so you can show other floaters what the river looks like right now.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://eddy.guide",
      "router": {},
      "eas": {
        "projectId": "018d7a3e-7e3c-47a9-bd02-1fe370317a7f"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/018d7a3e-7e3c-47a9-bd02-1fe370317a7f"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}
