{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@eddy/types": [
        "../packages/eddy-types/index.ts"
      ],
      "@eddy/offline": [
        "../packages/eddy-offline/index.ts"
      ],
      "@eddy/geo": [
        "../packages/eddy-geo/index.ts"
      ],
      "@shared/*": [
        "../missouri-float-planner/shared/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../packages/eddy-types/index.ts",
    "../packages/eddy-geo/index.ts",
    "../packages/eddy-offline/index.ts",
    "../missouri-float-planner/shared/condition-system.ts"
  ]
}