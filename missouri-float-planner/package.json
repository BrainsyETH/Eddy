{
  "name": "missouri-float-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "share:render-previews": "node --import tsx scripts/render-link-previews.tsx",
    "test:safe-zones": "tsx --tsconfig tsconfig.test.json --test shared/social-brand.test.ts",
    "test:today": "tsx --tsconfig tsconfig.test.json --test src/lib/today-recommendation.spec.ts",
    "pretest": "npm run test:today",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:rainfall": "eslint --no-ignore scripts/rainfall/*.ts",
    "lint": "eslint src shared && npm run lint:rainfall && npm run lint:tokens",
    "lint:tokens": "tsx scripts/check-tailwind-tokens.ts",
    "test": "tsx scripts/run-tests.ts",
    "check:eddy-knowledge": "tsx scripts/check-eddy-knowledge.ts",
    "audit:eddy-reads": "tsx scripts/audit-eddy-reads.ts",
    "report:eddy-reads": "tsx scripts/report-eddy-reads.ts",
    "test:links": "tsx scripts/check-dead-links.ts",
    "audit:pages": "tsx scripts/check-dead-links.ts",
    "db:import-rivers": "tsx scripts/import-nhd-rivers.ts",
    "db:import-gauges": "tsx scripts/fetch-gauge-stations.ts",
    "db:snap-access-points": "tsx scripts/snap-access-points.ts",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:check-client-access": "tsx scripts/check-client-access.ts",
    "db:check-migrations": "tsx scripts/check-migration-drift.ts",
    "db:check-access-slugs": "tsx --tsconfig tsconfig.test.json scripts/check-access-slugs.ts",
    "db:gen-types": "npx supabase gen types typescript --project-id ilefwfpvphadsbptiaur --schema public > src/types/database.ts.tmp && grep -q '^export type Json' src/types/database.ts.tmp && mv src/types/database.ts.tmp src/types/database.ts || (rm -f src/types/database.ts.tmp; echo 'db:gen-types failed; src/types/database.ts left unchanged'; exit 1)",
    "db:import-mile-markers": "tsx scripts/import-mile-markers.ts",
    "db:correct-miles": "tsx scripts/correct-access-point-miles.ts",
    "db:verify-directions": "tsx scripts/verify-river-directions.ts",
    "db:validate": "tsx scripts/validate-data.ts",
    "db:check-services": "tsx --tsconfig tsconfig.test.json scripts/check-service-model.ts",
    "db:import-access-points": "tsx scripts/import-access-points-csv.ts",
    "db:import-services": "tsx scripts/import-services-csv.ts",
    "db:fix-gauges": "tsx scripts/fix-gauge-associations.ts",
    "db:sync-thresholds": "tsx scripts/sync-gauge-thresholds.ts",
    "db:import-rivers-tnm": "tsx scripts/import-nhd-rivers-from-tnm.ts",
    "data:build-outline": "tsx scripts/build-mo-outline.ts",
    "db:import-segments": "tsx scripts/import-float-segments.ts",
    "db:seed": "echo 'Run seed SQL files via Supabase CLI or SQL Editor. See scripts/run-seeds.ts for details.'",
    "db:setup": "npm run db:seed && npm run db:snap-access-points",
    "db:fix-geometry": "npm run db:import-rivers && npm run db:verify-directions && npm run db:snap-access-points",
    "video:dev": "cd remotion && npx remotion studio",
    "video:generate": "cd remotion && npx tsx scripts/generate-video.ts",
    "video:generate:assets": "cd remotion && npx tsx scripts/generate-video.ts --assets-only",
    "video:generate:render": "cd remotion && npx tsx scripts/generate-video.ts --render-only",
    "video:render": "cd remotion && npx remotion render Root tutorial-full out/eddy-tutorial-landscape.mp4",
    "video:render:vertical": "cd remotion && npx remotion render Root tutorial-full-vertical out/eddy-tutorial-vertical.mp4",
    "video:render:all": "npm run video:render && npm run video:render:vertical",
    "video:studio": "cd remotion && npx remotion studio",
    "promo:capture": "cd remotion && node scripts/capture-promo.mjs",
    "promo:render": "cd remotion && bash scripts/render-promo.sh",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit && node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "db:readiness": "tsx scripts/ingestion/audit-readiness.ts",
    "test:dam-page": "node scripts/dam-page-smoke.mjs",
    "test:release-timing": "node scripts/release-timing-smoke.mjs",
    "test:navigation": "node scripts/navigation-smoke.mjs",
    "test:analytics-browser": "node scripts/analytics-browser-smoke.mjs && tsx scripts/audit-browser-smoke.ts",
    "test:planner-map": "node scripts/planner-map-smoke.mjs",
    "test:float-finder": "node scripts/float-finder-smoke.mjs",
    "test:river-strip": "node scripts/river-strip-smoke.mjs",
    "test:conditions": "node scripts/conditions-smoke.mjs",
    "test:national-gauges": "NATIONAL_GAUGES_ONLY=1 node scripts/planner-map-smoke.mjs",
    "build:visual-guides": "node --import tsx scripts/build-visual-guides.ts",
    "check:visual-guides": "node --import tsx scripts/build-visual-guides.ts --check",
    "test:visual-guides": "node scripts/check-visual-guides.mjs",
    "test:lakes": "node scripts/lakes-experience-smoke.mjs",
    "test:guides": "node scripts/river-guides-smoke.mjs",
    "test:admin-browser": "node scripts/admin/workspace-smoke.mjs && node scripts/admin/inbox-smoke.mjs && node scripts/admin/places-smoke.mjs",
    "test:admin-db": "node scripts/admin/workspace-db-check.mjs",
    "test:daily-report": "node --import tsx scripts/daily-report-smoke.mjs",
    "test:camping-browser": "node scripts/camping-smoke.mjs",
    "test:camping-capacity": "node --import tsx scripts/camping-capacity-check.ts",
    "test:river-report": "node scripts/river-report-smoke.mjs",
    "test:river-sections": "node scripts/river-sections-smoke.mjs && npm run test:river-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@coinbase/x402": "^2.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@remotion/player": "4.0.410",
    "@sentry/nextjs": "^10.75.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.0",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/extension-color": "^3.34.0",
    "@tiptap/extension-heading": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@turf/turf": "^7.3.2",
    "@vercel/blob": "^2.6.1",
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/extensions": "^2.18.0",
    "@x402/svm": "^2.18.0",
    "exifr": "^7.1.3",
    "github": "^14.0.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.14",
    "lucide-react": "^0.263.1",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remotion": "4.0.410",
    "resend": "^6.38.0",
    "sanitize-html": "^2.18.2",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "geo-tz": "8.1.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@types/shpjs": "^3.4.7",
    "@types/topojson-client": "^3.1.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "postcss": "8.5.23",
    "shpjs": "^6.2.0",
    "supabase": "2.111.0",
    "tailwindcss": "^3.4.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "us-atlas": "^3.0.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "axios": "^1.20.0",
    "nanoid": "^3.3.17",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
